# PostgreSQL / PostGIS
DB_NAME=hydro_registry
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# OpenRouter (разбор колонок через LLM)
OPEN_ROUTER=

# Оффлайн-режим без OpenRouter (демо/локальный тест): маппинг колонок по
# ключевым словам без вызова LLM. Раскомментируй, чтобы включить.
# INGESTION_FAKE_MAPPER=1

# GeoDjango (опционально, если авто-поиск не сработал)
# GDAL_LIBRARY_PATH=C:\Program Files\PostgreSQL\16\bin\libgdal-35.dll
# GEOS_LIBRARY_PATH=C:\Program Files\PostgreSQL\16\bin\libgeos_c.dll
